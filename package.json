{
  "name": "angular-nestjs-graphql-template",
  "packageManager": "yarn@4.18.0",
  "type": "module",
  "scripts": {
    "lint": "eslint ./ --cache --cache-location .eslintcache --no-warn-ignored",
    "lint:fix": "node --run lint -- --fix",
    "prepare": "husky"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/template-parser": "^22.5.0",
    "@antfu/eslint-config": "^9.5.1",
    "@nx/angular": "^23.2.1",
    "@types/node": "^26",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "nx": "^23.2.1",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "node --run lint"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}

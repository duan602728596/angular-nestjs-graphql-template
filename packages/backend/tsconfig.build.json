{
  "extends": "./tsconfig.json",
  "include": [
    "./src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    "./codegen.ts",
    "./graphql"
  ],
  "watchOptions": {
    "excludeDirectories": [
      "../../**/node_modules",
      "./.nest",
      "./dist",
      "./graphql",
      "./public",
      "./test",
      "../frontend",
      "../frontend-serve"
    ]
  }
}

{
  "name": "@angular-nestjs-graphql-template/backend",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_ENV=production nest build",
    "start": "cross-env NODE_ENV=development nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_OPTIONS=\"--enable-source-maps\" node dist/main.js",
    "codegen:build": "node dist/scripts/graphql/graphql.generate.js && graphql-codegen",
    "codegen:watch": "graphql-codegen --watch",
    "spectaql:build": "spectaql spectaql.config.yaml",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.ts",
    "test:watch": "node --run test -- --watch",
    "test:cov": "node --run test -- --coverage",
    "test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest-e2e.config.ts"
  },
  "dependencies": {
    "@angular-nestjs-graphql-template/shared": "workspace:*",
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.0.1",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/graphql": "^14.0.1",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/serve-static": "^12.0.0",
    "compression": "^1.8.2",
    "graphql": "^17.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.3.1",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@types/compression": "^1",
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/jest": "^30",
    "@types/supertest": "^7",
    "cross-env": "^10.1.0",
    "jest": "^30.5.1",
    "source-map-support": "^0.5.21",
    "spectaql": "^3.0.9",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}

{
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "target": "ESNext",
    "newLine": "LF",
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@backend/*": [
        "./packages/backend/*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "exclude": [
    "node_modules"
  ]
}